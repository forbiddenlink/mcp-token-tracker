{
  "name": "mcp-token-tracker",
  "version": "1.0.0",
  "description": "Track MCP server token usage and costs for AI coding tools",
  "type": "module",
  "bin": {
    "mcp-token-tracker": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "pnpm run build && pnpm run test",
    "dev": "tsx src/cli.ts scan",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "security": "pnpm audit --audit-level high",
    "audit": "pnpm audit --audit-level high",
    "lint-baseline": "biome check ."
  },
  "keywords": [
    "mcp",
    "tokens",
    "cursor",
    "windsurf",
    "claude",
    "ai",
    "cost"
  ],
  "author": "Elizabeth Stein",
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "langfuse": "^3.38.20",
    "pino": "^10.3.1",
    "tiktoken": "^1.0.22",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pino": "7.0.5",
    "@types/update-notifier": "6.0.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=1.19.13 <3",
      "express-rate-limit": ">=8.2.2 <9",
      "fast-uri": ">=4.1.3 <5",
      "hono": ">=4.13.5 <5",
      "path-to-regexp": ">=8.4.0 <9",
      "qs": ">=6.16.0 <7",
      "vite": ">=8.0.16 <9"
    }
  }
}
